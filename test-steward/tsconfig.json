{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    // Type-checking only (doesn't affect esbuild/Vite's actual runtime
    // transform) — permits the default imports below (moment, node:path)
    // without pulling in full esModuleInterop, which would also change how
    // namespace imports like spark-md5's typecheck for src/ files reached
    // transitively from here.
    "allowSyntheticDefaultImports": true,
    "paths": {
      // Points type-checking at the same fake used at test runtime (aliased
      // in vitest.steward.config.mts) — the real "obsidian" package ships types for
      // its full API, which test-steward/mocks/obsidian.ts deliberately doesn't
      // match (see the comment at the top of that file).
      "obsidian": ["test-steward/mocks/obsidian.ts"]
    }
  },
  "include": ["**/*.ts", "../vitest.steward.config.mts"],
  // plugin.test.ts loads the whole plugin, settings UI included, which the
  // simplified mock doesn't type; vitest still runs it.
  "exclude": ["plugin.test.ts"]
}
