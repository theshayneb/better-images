{
	"name": "better-images",
	"version": "1.0.1",
	"description": "Keeps attachments organized in templated folders and filenames without breaking links (Attachment Steward), and lets you crop, rotate and flip images from their right-click menu.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit && tsc -noEmit -p test-steward/tsconfig.json",
		"lint": "eslint \"src/**/*.ts\"",
		"test": "vitest run && vitest run -c vitest.steward.config.mts"
	},
	"keywords": [],
	"author": "theshayneb",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.35.0",
		"@types/node": "^24.3.1",
		"@types/spark-md5": "^3.0.5",
		"@typescript-eslint/eslint-plugin": "^8.42.0",
		"@typescript-eslint/parser": "^8.42.0",
		"@vitest/coverage-v8": "^3.2.4",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.25.9",
		"eslint": "^9.35.0",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^16.3.0",
		"happy-dom": "^18.0.1",
		"moment": "^2.29.4",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"spark-md5": "^3.0.2"
	}
}
