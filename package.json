{
  "name": "attachment-steward",
  "version": "0.2.1",
  "description": "Organizes attachments into templated folders and filenames - never loses the original filename, never breaks links elsewhere, and catches bulk imports the moment they land.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/spark-md5": "^3.0.4",
    "chokidar": "^3.6.0",
    "esbuild": "^0.21.5",
    "moment": "2.29.4",
    "obsidian": "latest",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "spark-md5": "^3.0.2"
  }
}
